# NEAR
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://test.rpc.fastnear.com
KINFOLIO_CONTRACT_ID=            # e.g. kinfolio.<you>.testnet
MPC_CONTRACT_ID=v1.signer-prod.testnet

# Relayer (pays gas for heir meta-transactions; only relays calls to KINFOLIO_CONTRACT_ID)
RELAYER_ACCOUNT_ID=
RELAYER_PRIVATE_KEY=             # ed25519:... never commit

# Keeper (calls distribute_* and broadcasts signed foreign txs)
KEEPER_ACCOUNT_ID=
KEEPER_PRIVATE_KEY=

# Foreign chains
BTC_MEMPOOL_API=https://mempool.space/testnet4/api
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
SPLITTER_ADDRESS=0xae3a286351dac27a3ee6662296629538ec1d3f08  # KinfolioSplitter on Base Sepolia (deployed 12 Nov 2026)

# NEAR Intents 1Click (mainnet only; JWT optional, avoids extra fee)
ONECLICK_JWT=
