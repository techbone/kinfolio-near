# Copy to .env (repo root). Never commit .env.

# --- Web app (all optional: the defaults point at the live testnet deployment)
NEXT_PUBLIC_KINFOLIO_CONTRACT=app.kinfolio-musa.testnet
NEXT_PUBLIC_NEAR_RPC=https://test.rpc.fastnear.com        # falls back to near-testnet.drpc.org on 429s
NEXT_PUBLIC_BTC_MEMPOOL_API=https://mempool.space/testnet4/api  # falls back to blockstream.info/testnet4/api
NEXT_PUBLIC_BASE_SEPOLIA_RPC=https://sepolia.base.org
NEXT_PUBLIC_DEMO_TRUST_ID=0        # the "live demo trust" on the home page
NEXT_PUBLIC_RELEASED_TRUST_ID=6    # the "trust that paid out" on the home page

# --- Headless e2e (web/scripts/e2e.ts). NEAR keys are read from ~/.near-credentials/testnet/<account>.json
E2E_OWNER=kinfolio-musa.testnet
E2E_HEIR_A=heir-a.kinfolio-musa.testnet
E2E_HEIR_B=heir-b.kinfolio-musa.testnet
E2E_HEIR_A_BTC=                    # tb1q... payout address for heir A
E2E_HEIR_B_BTC=
E2E_HEIR_A_EVM=                    # 0x... payout address for heir A
E2E_HEIR_B_EVM=
E2E_FUND_FROM_TRUST=0              # an Active trust owned by E2E_OWNER that holds testnet4 BTC
E2E_FUND_SATS=12000
E2E_FUND_WEI=2000000000000000      # 0.002 ETH sent to the new trust from the deployer key
DEPLOYER_EVM_PRIVATE_KEY=          # Base Sepolia key with a little ETH (also deploys the splitter)

# --- Deployed addresses (for reference)
SPLITTER_ADDRESS=0xae3a286351dac27a3ee6662296629538ec1d3f08  # KinfolioSplitter on Base Sepolia
MPC_CONTRACT_ID=v1.signer-prod.testnet
